# 第一次使用：
#   cp config.yaml.example config.yaml   (Mac/Linux)
#   copy config.yaml.example config.yaml (Windows)
# 然后把下面空的 "" 位置补上实际值。
# config.yaml 已被 .gitignore 忽略，不会提交。

# ========= MySQL（devops 元数据库） =========
mysql:
  host: ""
  port: 3306
  user: ""
  password: ""
  database: devops
  # {schemas} 会被替换为逗号分隔的 4 个库名的带引号列表
  # 两表 join：tenant_info.schemaname → instance_info，按 number 关联
  query_sql: >
    SELECT t.schemaname, t.product,
           i.env, i.serverinnerip, i.serverport,
           i.serverouterip, i.serverouterport,
           i.name, i.datacenter, i.instance_type
    FROM tenant_info t
    JOIN instance_info i ON t.number = i.number
    WHERE t.schemaname IN ({schemas})

  # 阿里/华为 ECS 的 serverinnerip 可能是 VIP（集群）或 ECS 本身 IP（单机）。
  # 查到的 IP 先用这条 SQL 匹配 vip 列：匹配到 → 用 masterip 代替；没匹配到 → 原样
  havip_lookup_sql: "SELECT masterip FROM havip WHERE vip = %s LIMIT 1"

# ========= Grafana =========
grafana:
  base: ""
  username: ""
  password: ""
  # 默认时间窗（最近 1 小时）
  default_from: now-1h
  default_to: now
  # 各类面板 uid
  dashboards:
    ali_ecs:       R6xg1AkGk   # 阿里云 ECS 监控
    ali_rds:       yl8PwrzMk   # 阿里云 RDS 监控
    ali_polardb:   TTvuGPaSz   # 阿里云 PolarDB MySQL 监控
    hw_ecs:        YsreRunGz   # 华为云 ECS 监控
    hw_rds:        VfbmJbgnk   # 华为云 RDS 监控
    hw_taurusdb:   hnwDKXYIz   # 华为云 GaussDB(for MySQL) 监控

  # 各面板里要截的 panel：显示名 -> panelId
  # 顺序就是截图纵向拼接顺序
  panels:
    ali_ecs:
      CPU: 10
      内存: 23
      磁盘IOPS: 6
      磁盘吞吐量: 5
    ali_rds:
      CPU: 29
      内存: 34
      IOPS: 26
    ali_polardb:
      CPU: 29
      内存: 34
      PCU个数: 39
    hw_ecs:
      CPU: 10
      内存: 16
      磁盘IOPS: 24
      磁盘吞吐量: 23
    hw_rds:
      CPU: 10
      内存: 16
      磁盘IOPS: 22
    hw_taurusdb:
      CPU: 43
      内存: 10
      磁盘IOPS: 22
      磁盘吞吐量: 35

# ========= Grafana 截图（Playwright） =========
screenshot:
  enabled: true
  # 单个 panel 截图尺寸（像素）
  panel_width: 900
  panel_height: 300
  # 最多等 Grafana 面板渲染多少秒
  render_timeout_sec: 20
  # cookie 持久化路径，登录态会保存到这里；首次无文件时自动走表单登录
  storage_state_path: .playwright_state.json
  # Chromium 无头模式
  headless: true
  # 本机内存缓存：同一 (tenant, instance_key) 多少秒内复用 PNG
  cache_ttl_sec: 60
  # 浏览器通道。空=用 Playwright 自带的 chromium（headless_shell.exe）
  # 遇到 "spawn UNKNOWN" / 杀软拦截时可改为：
  #   chrome  → 用系统装的 Google Chrome
  #   msedge  → 用系统自带的 Microsoft Edge（Windows 推荐）
  channel: ""

# ========= Kibana / ELK =========
kibana:
  base: ""
  # 兜底 index pattern id（当 datacenter/product 匹配不上时用）
  index_pattern: ""
  # 按 datacenter + product 选 index UUID。
  # WFM3 产品用 MSSQL 慢日志；其它用 MySQL 慢日志。
  index_uuids:
    ali_mysql:   ""   # ali-mysql_slow_log-*
    ali_mssql:   ""   # ali-mssqlslowlog_p-*
    hw_mysql:    ""   # hw-mysql_slow_log-*
    hw_mssql:    ""   # hw-mssqlslowlog_p-*
  default_from: now-1h
  default_to: now
  # Kibana 账号密码（只在短链功能启用时需要）
  username: ""
  password: ""
  verify_ssl: true

# ========= Web 服务 =========
server:
  host: 0.0.0.0
  port: 5001

# ========= 阿里云 Open API =========
# 用来查 PolarDB 集群对应的 Writer 节点 ID，供 Grafana 变量使用
# RAM 用户权限：AliyunPolarDBReadOnlyAccess 即可
aliyun:
  access_key_id: ""
  access_key_secret: ""
  region_id: cn-shanghai

# ========= 华为云 Open API =========
# 用来查 GaussDB(for MySQL)/TaurusDB 实例对应的 Master 节点 ID
# IAM 子账号权限：GaussDB ReadOnlyAccess 即可
# project_id 从 IAM → 我的凭证 → 项目列表 查看
huaweicloud:
  access_key_id: ""
  access_key_secret: ""
  region_id: ""
  project_id: ""

# ========= 飞书机器人 =========
feishu:
  # 从「开发者后台 → 凭证与基础信息」拿
  app_id: ""
  app_secret: ""
  # 事件配置里的 Verification Token
  verification_token: ""
  # 本服务可外部访问的 base URL（给飞书下载截图用）
  # 空则用 http://<server.host>:<server.port>
  public_base_url: ""
  # 识别"@了本机器人"的方式（三选一，优先级：open_id > name > 都空则按 mentioned_type=bot 放行）
  # 1. 填 bot_open_id：从事件日志 mentions.id.open_id 复制（最精确）
  # 2. 填 bot_name：机器人显示名，比如 "DB_Monitor"
  # 3. 两个都空：群里只要 @ 到任意机器人就响应（群里只有一个机器人时最省事）
  bot_open_id: ""
  bot_name: ""

# ========= 租户 -> 4 个库的推导规则 =========
# {code} 会被替换为租户代码
# 顺序：考勤 / 排班 / 新人事 / 计算累计（与 schema_labels 对应）
schemas:
  - "{code}"
  - "schedule_{code}"
  - "corehr_{code}"
  - "gaia_acc_{code}"

# 每个库在网页和截图里显示的业务名
# key 是 schemas 里的模板；value 是展示名
schema_labels:
  "{code}": "考勤"
  "schedule_{code}": "排班"
  "corehr_{code}": "新人事"
  "gaia_acc_{code}": "计算累计"
